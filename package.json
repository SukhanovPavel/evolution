{
  "name": "evolution",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts",
    "test:demo": "node scripts/test-demo.mjs",
    "db:prepare": "node scripts/migrate-supabase.mjs --prepare",
    "db:migrate": "node --env-file=.env.local scripts/migrate-supabase.mjs",
    "supabase:status": "node --env-file=.env.local scripts/supabase-status.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:cloud:rls": "node --env-file=.env.local scripts/test-supabase-rls.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=12.2.0"
  },
  "packageManager": "npm@12.2.0"
}
